# Ключ доступа к приложению: 8–255 символов, только A-Z a-z 0-9 - _
ACCESS_KEY=change-me-please

# Ключ Google Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Модель Gemini (алиас на актуальную flash-модель)
GEMINI_MODEL=gemini-flash-latest

# Необязательно: прокси только для запросов к Gemini (http://, https://, socks5://)
GEMINI_PROXY=

# Ставьте true, если приложение отдаётся по HTTPS
COOKIE_SECURE=false
